# ── Linter script ──────────────────────────────────────────────────────────


def test_check_architecture_passes():
    """check_architecture.py must exit 0 on the current codebase."""
    result = subprocess.run(
        [sys.executable, "scripts/check_architecture.py"],
        capture_output=True, text=True, cwd=REPO_ROOT,
    )
    assert result.returncode == 0, (
        "\n\nARCHITECTURE LINTER FAILED:\n"
        + result.stdout + result.stderr
        + "\n\nFix all violations before merging."
    )


# ── Docs cross-links ───────────────────────────────────────────────────────


def test_docs_links_exist():
    """Markdown links in docs/ must point to files that exist."""
    import re
    broken: list[str] = []
    link_re = re.compile(r'\[.*?\]\(([^)#]+)\)')
    for md in (REPO_ROOT / "docs").rglob("*.md"):
        for match in link_re.finditer(md.read_text()):
            target = match.group(1)
            if target.startswith("http"):
                continue
            if not (md.parent / target).resolve().exists():
                broken.append(f"  {md.relative_to(REPO_ROOT)} → {target}")
    assert not broken, (
        "\n\nBROKEN DOC LINKS:\n" + "\n".join(broken)
        + "\n\n  REMEDIATION: Update the link or create the missing file."
        "\n  Stale docs are bugs. See docs/workflows.md."
    )

# .codex/config.toml — {{REPO_NAME}}
#
# Codex project-local config. Registers UserPromptSubmit and Stop hooks
# that delegate to the shared scripts under scripts/.
#
# Hook behaviour: every command hook receives one JSON object on stdin.
# Hooks may print JSON to stdout to influence Codex (continue, stopReason,
# systemMessage, suppressOutput). Here we print plain text via the shared
# nudge scripts; Codex surfaces the text in the session context.
#
# Reference: https://developers.openai.com/codex/hooks

[[hooks.UserPromptSubmit]]
command = "bash .codex/hooks/user_prompt_submit.sh"

[[hooks.Stop]]
command = "bash .codex/hooks/stop_nudge.sh"

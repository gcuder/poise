#!/usr/bin/env bash
# .claude/hooks/exit_plan_mode.sh — {{REPO_NAME}}
#
# PostToolUse hook on ExitPlanMode. Copies the newest ~/.claude/plans/*.md into
# docs/exec-plans/active/<slug>.md as an OKF exec plan (frontmatter with
# status: draft and verified by the approving human). Logic lives in
# scripts/capture_plan.py so every agent records plans the same way.

PROJECT_DIR="${CLAUDE_PROJECT_DIR:-$PWD}"
python3 "$PROJECT_DIR/scripts/capture_plan.py" --by claude-code/plan-mode || true
exit 0

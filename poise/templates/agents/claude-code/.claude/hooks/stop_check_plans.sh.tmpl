#!/usr/bin/env bash
# .claude/hooks/stop_check_plans.sh — {{REPO_NAME}}
#
# Stop hook: a plan with every box ticked needs a commit, because the lefthook
# pre-commit moves it to docs/exec-plans/completed/ in that commit. Moving it
# here would leave the move uncommitted after the turn.
#
# Exit 2 sends the message to the agent and keeps the turn open. Exit 0 output
# never reaches the agent. stop_hook_active is true on the turn this hook
# reopened, so the agent is asked once and can never loop.

INPUT=$(cat)
case "$INPUT" in
  *'"stop_hook_active":true'* | *'"stop_hook_active": true'*) exit 0 ;;
esac

PROJECT_DIR="${CLAUDE_PROJECT_DIR:-$PWD}"
OUT=$(python3 "$PROJECT_DIR/scripts/archive_plans.py" --check </dev/null) || exit 0
if [ -n "$OUT" ]; then
  echo "$OUT" >&2
  exit 2
fi
exit 0

#!/usr/bin/env bash
# .claude/hooks/stop_check_plans.sh — {{REPO_NAME}}
#
# Stop hook: when all checkboxes in an active plan are ticked, move it to
# docs/exec-plans/completed/ (status: stable, completed_at) and log it in
# docs/exec-plans/log.md. Logic lives in scripts/archive_plans.py, shared with
# the other adapters.
#
# Stop fires every turn — the script is idempotent and silent on no-op.
# --min-age 5 skips files touched within the last 5s to avoid racing with
# the ExitPlanMode hook that just wrote the active plan.

PROJECT_DIR="${CLAUDE_PROJECT_DIR:-$PWD}"
python3 "$PROJECT_DIR/scripts/archive_plans.py" --min-age 5 || true
exit 0

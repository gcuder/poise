/**
 * harness.ts — {{REPO_NAME}}
 *
 * OpenCode plugin: enforces architecture boundaries after every file write.
 * Mirrors the Claude Code PostToolUse hook behaviour.
 *
 * Fires on: write, edit, apply_patch tool completions
 * Output: surfaced in the OpenCode session context
 *
 * Docs: https://opencode.ai/docs/plugins/
 */

export default function (ctx: any) {
  // OpenCode has no first-class SessionStart event. We print the harness brief
  // (rules + active plan) once per plugin load, on the first event we see.
  let briefed = false;

  return {
    hooks: {
      /**
       * Post-write: format → lint → architecture check.
       * Output is injected into the agent's context window.
       */
      "tool.execute.after": async (event: any) => {
        const tool = event.input?.tool as string | undefined;
        if (!tool || !["write", "edit", "apply_patch"].includes(tool)) {
          return;
        }

        // Resolve file path from tool input
        const filePath: string | undefined =
          event.input?.args?.filePath ||
          event.input?.args?.path ||
          event.input?.args?.file;

        if (!filePath) return;

        const ext = filePath.split(".").pop() ?? "";

        {{FORMAT_BLOCK_TS}}
        // Python: if (ext === "py") { await ctx.exec(`ruff format "${filePath}" --quiet`).catch(() => {}); }
        // TypeScript: if (["ts","tsx"].includes(ext)) { await ctx.exec(`npx prettier --write "${filePath}" --log-level silent`).catch(() => {}); }
        // Go: if (ext === "go") { await ctx.exec(`gofmt -w "${filePath}"`).catch(() => {}); }

        {{LINT_BLOCK_TS}}
        // Python:
        // if (ext === "py") {
        //   const lint = await ctx.exec(`ruff check "${filePath}" --output-format=text`).catch((e: any) => e);
        //   if (lint?.stdout) ctx.log(`RUFF LINT ISSUES:\n${lint.stdout}`);
        // }

        {{ARCH_CHECK_BLOCK_TS}}
        // Python:
        // if (ext === "py") {
        //   const arch = await ctx.exec(`python scripts/check_architecture.py "${filePath}"`).catch((e: any) => e);
        //   if (arch?.stdout?.includes("BOUNDARY VIOLATION")) {
        //     ctx.log(`\n${arch.stdout}\nSTOP: Fix the boundary violation before writing more code.\nEach violation includes a REMEDIATION instruction — follow it.`);
        //   }
        // }

        {{STYLE_CHECK_BLOCK_TS}}
        // Python:
        // if (ext === "py") {
        //   const style = await ctx.exec(`python scripts/check_style.py "${filePath}"`).catch((e: any) => e);
        //   if (style?.stdout?.includes("STYLE VIOLATION")) {
        //     ctx.log(`\n${style.stdout}\nSTOP: Fix the style violation before writing more code.\nEach violation includes a REMEDIATION instruction — follow it.`);
        //   }
        // }
      },

      /**
       * Session idle (≈ Claude Code "Stop"): fires when the agent
       * finishes responding. We call the shared nudge_docs.py to flag
       * sessions that touched many files without updating any docs.
       * Advisory only — output goes via ctx.log into the session context.
       */
      "session.idle": async () => {
        try {
          const out = await ctx.exec("python3 scripts/nudge_docs.py");
          if (out?.stdout?.trim()) ctx.log(out.stdout);
        } catch {
          // Nudges never block — swallow.
        }
      },

      /**
       * Generic event hook: best-effort plan-mode nudge.
       *
       * OpenCode does not expose a clean UserPromptSubmit equivalent
       * (see https://github.com/anomalyco/opencode/issues/17412 for the
       * upstream feature request to inject AI-visible messages). We
       * intercept prompt-shaped events here and pipe the prompt text
       * into the shared nudge_plan.py. Output is logged via ctx.log,
       * which may or may not be surfaced into the model's input
       * depending on the OpenCode version.
       */
      "event": async (event: any) => {
        // Best-effort SessionStart brief: fire once, on the first event.
        if (!briefed) {
          briefed = true;
          try {
            const b = await ctx.exec("python3 scripts/session_brief.py");
            if (b?.stdout?.trim()) ctx.log(b.stdout);
          } catch {
            // Best-effort only.
          }
        }

        const type: string = event?.type ?? "";
        if (!/prompt|message|input/i.test(type)) return;
        const prompt: string =
          event?.payload?.prompt ??
          event?.payload?.text ??
          event?.payload?.message ??
          "";
        if (!prompt) return;
        try {
          const payload = JSON.stringify({ prompt });
          const out = await ctx.exec(
            `printf %s ${JSON.stringify(payload)} | python3 scripts/nudge_plan.py`,
          );
          if (out?.stdout?.trim()) ctx.log(out.stdout);
        } catch {
          // Best-effort only.
        }
      },

      /**
       * Pre-execution guard:
       *   - write/edit/apply_patch → plan gate (block multi-file source edits
       *     until an execution plan exists; delegates to require_plan.py)
       *   - bash → block destructive commands
       * Throw an error to cancel the operation.
       */
      "tool.execute.before": async (event: any) => {
        const tool = event.input?.tool as string | undefined;

        // Plan gate (on by default; disable with POISE_GATE=0).
        if (tool && ["write", "edit", "apply_patch"].includes(tool)) {
          const filePath: string =
            event.input?.args?.filePath ||
            event.input?.args?.path ||
            event.input?.args?.file ||
            "";
          const sessionId: string =
            event?.sessionID || event?.session?.id || "default";
          try {
            const payload = JSON.stringify({
              tool_input: { file_path: filePath },
              session_id: sessionId,
            });
            // require_plan.py exits non-zero to block; ctx.exec rejects on that.
            await ctx.exec(
              `printf %s ${JSON.stringify(payload)} | python3 scripts/require_plan.py --pretooluse`,
            );
          } catch (e: any) {
            const reason =
              (typeof e?.stderr === "string" && e.stderr.trim()) ||
              "POISE PLAN GATE: create docs/exec-plans/active/<slug>.md before " +
                "editing more source files (disable with POISE_GATE=0).";
            throw new Error(reason);
          }
          return;
        }

        if (tool !== "bash") return;

        const command: string = event.input?.args?.command ?? "";

        const DANGEROUS = [
          /rm\s+-rf\s+\//,
          /DROP\s+TABLE/i,
          /DROP\s+DATABASE/i,
          {{DANGEROUS_PATTERNS_TS}}
          // /gcloud\s+run.*delete/i,   // Cloud Run
          // /kubectl\s+delete\s+namespace/i,  // k8s
        ];

        for (const pattern of DANGEROUS) {
          if (pattern.test(command)) {
            throw new Error(
              `BLOCKED: Dangerous command pattern detected.\n` +
              `Command: ${command}\n` +
              `If intentional, run this manually in your terminal.`
            );
          }
        }

        const SECRET_PATTERNS = [
          /echo.*password/i,
          /cat.*\.env/,
          /printenv.*(KEY|SECRET|TOKEN)/i,
          {{SECRET_PATTERNS_TS}}
        ];

        for (const pattern of SECRET_PATTERNS) {
          if (pattern.test(command)) {
            throw new Error(
              `BLOCKED: Potential secret exposure.\n` +
              `Command: ${command}\n` +
              `See docs/conventions.md#secrets.`
            );
          }
        }
      },
    },
  };
}

"""
Structural style tests for {{REPO_NAME}}.

These tests pin the golden-principle invariants in CI alongside the
architecture boundary tests. They test structure, not business logic.

Invariants:
  1. File-size ceiling      ({{MAX_FILE_LINES}} lines)
  2. Structured logging     (no banned calls)
  3. Naming conventions     (per glob / regex)
  4. Component structure    (per glob / required pattern)

Failures include remediation instructions for self-correction.
"""

import re
import subprocess
import sys
from pathlib import Path

import pytest

REPO_ROOT = Path(__file__).parent.parent
MAX_FILE_LINES: int = {{MAX_FILE_LINES}}
SOURCE_EXTENSIONS: set[str] = {{{SOURCE_EXTENSIONS_SET}}}
SKIP_DIRS: set[str] = {
    ".venv", "__pycache__", ".git", "tests", "scripts",
    "migrations", "node_modules", "dist", ".worktrees",
}


def source_files() -> list[Path]:
    return [
        f for f in REPO_ROOT.rglob("*")
        if f.suffix in SOURCE_EXTENSIONS
        and not any(s in f.parts for s in SKIP_DIRS)
    ]


# ── File size ──────────────────────────────────────────────────────────────


def test_no_file_exceeds_size_ceiling():
    """No source file may exceed MAX_FILE_LINES lines."""
    too_large: list[str] = []
    for filepath in source_files():
        lines = sum(1 for _ in filepath.open("rb"))
        if lines > MAX_FILE_LINES:
            too_large.append(
                f"\n  {filepath.relative_to(REPO_ROOT)} — {lines} lines "
                f"(ceiling {MAX_FILE_LINES})"
            )
    assert not too_large, (
        f"\n\nFILE-SIZE VIOLATIONS ({len(too_large)} found):"
        + "".join(too_large)
        + "\n\n  REMEDIATION: Split each file along a clear seam — one type "
        "per file, one concern per module. See docs/conventions.md#file-size."
    )



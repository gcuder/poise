# ── Linter script ──────────────────────────────────────────────────────────


def test_check_style_passes():
    """check_style.py must exit 0 on the current codebase."""
    result = subprocess.run(
        [sys.executable, "scripts/check_style.py"],
        capture_output=True, text=True, cwd=REPO_ROOT,
    )
    assert result.returncode == 0, (
        "\n\nSTYLE LINTER FAILED:\n"
        + result.stdout + result.stderr
        + "\n\nFix all violations before merging."
    )

#!/usr/bin/env python3
"""
Plan nudge for {{REPO_NAME}}.

Called by per-agent UserPromptSubmit (or closest) hooks. Reads a JSON
envelope on stdin (shape varies per agent; we look for `prompt` /
`user_prompt` / `text` fields). Two jobs, every turn:

  1. If an execution plan is active in docs/exec-plans/active/, re-surface a
     one-line reminder so the agent keeps working from it and ticking steps.
  2. Else, if the prompt looks multi-step, direct the agent to create a plan
     BEFORE editing.

The message is agent-directed and imperative (no "shift-tab", no "consider")
because nudges worded as optional get ignored. Adapters forward stdout into
the agent's context. This is a NUDGE, not a gate — exit code is always 0;
the hard enforcement lives in require_plan.py.

Multi-step heuristic (cheap, regex-only):
  - multi-step verb (refactor, implement, migrate, rebuild, build, add, ...)
  - cross-cutting hint (across, throughout, everywhere, all files, codebase)
  - >= MULTI_FILE_HINT explicit file references
  - prompt length > LONG_PROMPT_CHARS

Disable for a session by setting POISE_NUDGE_PLAN=0 in the env.
"""

import json
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _plans  # noqa: E402

MULTI_STEP_VERBS = re.compile(
    r"\b(refactor|implement|migrate|rewrite|rebuild|redesign|introduce|"
    r"add (a|the) new|build (a|the) new|set up|overhaul|port)\b",
    re.IGNORECASE,
)
CROSS_CUTTING = re.compile(
    r"\b(across|throughout|everywhere|all files|whole codebase|every module|"
    r"all of|each of|wide(-| )?ranging)\b",
    re.IGNORECASE,
)
FILE_REF = re.compile(r"[A-Za-z0-9_./-]+\.(py|ts|tsx|go|rs|java|kt|rb|md|yml|yaml|toml|json)\b")

MULTI_FILE_HINT = 3
LONG_PROMPT_CHARS = 600


def extract_prompt(payload: dict) -> str:
    for key in ("prompt", "user_prompt", "text", "input", "message"):
        if isinstance(payload.get(key), str):
            return payload[key]
    # Fallback: stringify entire payload — heuristic still works on raw text.
    return json.dumps(payload)


def looks_multi_step(prompt: str) -> bool:
    if not prompt or len(prompt.strip()) < 40:
        return False
    score = 0
    if MULTI_STEP_VERBS.search(prompt):
        score += 1
    if CROSS_CUTTING.search(prompt):
        score += 1
    if len(FILE_REF.findall(prompt)) >= MULTI_FILE_HINT:
        score += 1
    if len(prompt) > LONG_PROMPT_CHARS:
        score += 1
    return score >= 2


def main() -> int:
    if os.environ.get("POISE_NUDGE_PLAN") == "0":
        return 0

    raw = sys.stdin.read()
    payload: dict = {}
    if raw.strip():
        try:
            payload = json.loads(raw)
        except json.JSONDecodeError:
            payload = {"prompt": raw}
    prompt = extract_prompt(payload) if payload else ""

    # 1. Re-surface an active plan so the agent keeps following it (every turn).
    active = _plans.summarize_active()
    if active:
        print("POISE: " + active)
        return 0

    # 2. No active plan: if the task looks multi-step, direct the agent to make one.
    if looks_multi_step(prompt):
        print(
            "POISE: this task looks multi-step. Before editing any files, produce "
            "an execution plan and save it to docs/exec-plans/active/<slug>.md "
            "(enter plan mode / use your plan tool, or run /plan). Do not start "
            "editing until the plan exists; then work from it, checking off "
            "`- [ ]` steps as you go. Disable this nudge with POISE_NUDGE_PLAN=0."
        )
    return 0


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""
Docs nudge for {{REPO_NAME}}.

Called by per-agent Stop / session.idle hooks. Looks at uncommitted +
staged changes on the current branch and flags work that touched many
source files without updating docs.

Adapters print this output as a system reminder when the session ends.
This is a NUDGE, not a gate — exit code is always 0.

Heuristic (cheap, git-based):
  - count source files changed since the branch diverged from origin/HEAD
  - count doc/spec/ADR/plan files changed in the same range
  - if source >= SOURCE_FLOOR and no doc files changed: nudge

Disable for a session by setting POISE_NUDGE_DOCS=0 in the env.
"""

import os
import subprocess
import sys
from pathlib import Path

SOURCE_FLOOR = 4   # how many source files trigger the nudge
SOURCE_EXTENSIONS = {".py", ".ts", ".tsx", ".go", ".rs", ".java", ".kt", ".rb"}
DOC_PREFIXES = (
    "docs/",
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
)


def _run(cmd: list[str]) -> str:
    try:
        return subprocess.run(
            cmd, capture_output=True, text=True, check=False
        ).stdout
    except FileNotFoundError:
        return ""


def changed_files() -> list[str]:
    # Range: branch divergence point → working tree. Fall back to HEAD diff
    # if origin/HEAD is unknown (e.g. detached HEAD, no remote).
    base = _run(["git", "merge-base", "HEAD", "origin/HEAD"]).strip()
    if not base:
        diff = _run(["git", "diff", "--name-only", "HEAD"])
    else:
        diff = _run(["git", "diff", "--name-only", f"{base}...HEAD"])
    diff += "\n" + _run(["git", "diff", "--name-only"])           # unstaged
    diff += "\n" + _run(["git", "diff", "--name-only", "--cached"])  # staged
    return sorted({line.strip() for line in diff.splitlines() if line.strip()})


def main() -> int:
    if os.environ.get("POISE_NUDGE_DOCS") == "0":
        return 0

    files = changed_files()
    if not files:
        return 0

    source = [f for f in files if Path(f).suffix in SOURCE_EXTENSIONS]
    docs = [f for f in files if f.startswith(DOC_PREFIXES)]

    if len(source) < SOURCE_FLOOR or docs:
        return 0

    sample = ", ".join(source[:3]) + ("…" if len(source) > 3 else "")
    print(
        f"POISE_NUDGE: this session edited {len(source)} source files "
        f"({sample}) but didn't touch any docs. Consider whether: "
        f"docs/quality.md should record what was fixed; "
        f"docs/decisions/ needs a new ADR; "
        f"docs/exec-plans/active/<slug>.md needs an update; "
        f"docs/conventions.md needs an example. "
        f"Disable with POISE_NUDGE_DOCS=0."
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""
Shared active-plan helpers for {{REPO_NAME}}.

Single source of truth for reading docs/exec-plans/active/ and the
`- [ ]` / `- [x]` checkbox convention. Imported by session_brief.py,
nudge_plan.py, and require_plan.py so every Python caller parses plans
identically.

Plans are OKF concepts (`type: Exec Plan`): the title comes from frontmatter
`title`, falling back to the first H1. archive_plans.py reuses parse_plan, so
the checkbox convention lives only here. The plan shape (REQUIRED_SECTIONS,
mirroring docs/exec-plans/template.md) lives here too, so capture_plan.py and
nudge_plan.py name the same sections.

Never raises into a hook — all file access is best-effort and returns
empty results on error.
"""

from __future__ import annotations

import os
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _okf  # noqa: E402

UNCHECKED_RE = re.compile(r"^- \[ \]\s*(.*)$")
CHECKED_RE = re.compile(r"^- \[[xX]\]\s*(.*)$")
TITLE_RE = re.compile(r"^#\s+(.*)$")
SECTION_RE = re.compile(r"^##\s+(.*?)\s*$")
COMMENT_RE = re.compile(r"<!--.*?-->", re.DOTALL)

# Sections every plan must have; the full shape is docs/exec-plans/template.md.
PLAN_SECTIONS = ["Summary", "Context", "Scope", "Approach", "Decisions",
                 "Open questions", "Changes", "Steps", "Risks", "Verification",
                 "Decision log"]
REQUIRED_SECTIONS = ["Summary", "Approach", "Decisions", "Steps", "Verification"]


def project_dir() -> Path:
    return Path(os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd())


def active_dir() -> Path:
    return project_dir() / "docs" / "exec-plans" / "active"


def iter_active_plans() -> list[Path]:
    """Active plan files, newest first. Empty list on any error."""
    try:
        plans = [p for p in active_dir().glob("*.md")
                 if p.is_file() and p.name not in _okf.RESERVED]
    except OSError:
        return []

    def _mtime(p: Path) -> float:
        try:
            return p.stat().st_mtime
        except OSError:
            return 0.0

    plans.sort(key=_mtime, reverse=True)
    return plans


def has_active_plan() -> bool:
    return bool(iter_active_plans())


def parse_plan(path: Path) -> dict:
    """Return {path, title, checked, unchecked, total, next_steps}."""
    meta, body = _okf.read(path)
    title = str((meta or {}).get("title") or "").strip() or path.stem
    checked = 0
    unchecked_steps: list[str] = []
    lines = body.splitlines()

    got_title = bool(meta and meta.get("title"))
    for line in lines:
        if not got_title:
            m = TITLE_RE.match(line)
            if m and m.group(1).strip():
                title = m.group(1).strip()
                got_title = True
        if CHECKED_RE.match(line):
            checked += 1
            continue
        m = UNCHECKED_RE.match(line)
        if m:
            unchecked_steps.append(m.group(1).strip() or "(unnamed step)")

    return {
        "path": path,
        "title": title,
        "checked": checked,
        "unchecked": len(unchecked_steps),
        "total": checked + len(unchecked_steps),
        "next_steps": unchecked_steps,
    }


def sections(body: str) -> dict[str, str]:
    """H2 heading (lower-cased) -> its text, with HTML comments removed."""
    out: dict[str, str] = {}
    current: str | None = None
    for line in COMMENT_RE.sub("", body).splitlines():
        m = SECTION_RE.match(line)
        if m:
            current = m.group(1).lower()
            out[current] = ""
        elif current is not None:
            out[current] += line + "\n"
    return out


def missing_sections(body: str) -> list[str]:
    """REQUIRED_SECTIONS absent or empty in the plan body (heading prefix match)."""
    found = sections(body)
    missing = []
    for name in REQUIRED_SECTIONS:
        texts = [t for h, t in found.items() if h.startswith(name.lower())]
        if not any(t.strip() for t in texts):
            missing.append(name)
    return missing


def open_questions(body: str) -> list[str]:
    """Unresolved items under `## Open questions` (not `none`, not `assumed: …`)."""
    text = sections(body).get("open questions", "")
    items = []
    for line in text.splitlines():
        item = re.sub(r"^\s*(?:[-*]|\d+\.)\s+", "", line).strip()
        if not item or item.lower().rstrip(".") == "none":
            continue
        if item.lower().startswith("assumed:"):
            continue
        items.append(item)
    return items


def _rel(path: Path) -> str:
    try:
        return str(path.relative_to(project_dir()))
    except ValueError:
        return str(path)


def summarize_active(max_plans: int = 2) -> str | None:
    """One imperative line per active plan, or None when there are none."""
    plans = iter_active_plans()
    if not plans:
        return None
    out: list[str] = []
    for p in plans[:max_plans]:
        info = parse_plan(p)
        out.append(
            f"active plan {_rel(p)} — {info['unchecked']} step(s) remaining. "
            f"Work from it and check off `- [ ]` steps as you complete them."
        )
    return "\n".join(out)


def brief_active(max_plans: int = 2, max_steps: int = 6) -> str | None:
    """Fuller multi-line block (title, progress, unchecked steps), or None."""
    plans = iter_active_plans()
    if not plans:
        return None
    out: list[str] = []
    for p in plans[:max_plans]:
        info = parse_plan(p)
        out.append(
            f"- {info['title']} ({_rel(p)}) — {info['checked']}/{info['total']} done"
        )
        for step in info["next_steps"][:max_steps]:
            out.append(f"    [ ] {step}")
        extra = info["unchecked"] - max_steps
        if extra > 0:
            out.append(f"    … +{extra} more step(s)")
    return "\n".join(out)

#!/usr/bin/env python3
"""
Archive fully checked plans for {{REPO_NAME}} without overwriting history.

A plan whose checkboxes are all `- [x]` moves from docs/exec-plans/active/ to
docs/exec-plans/completed/, its OKF frontmatter gets `status: stable` and
`completed_at`, and docs/exec-plans/log.md gets a newest-first entry.

The move has to land in a commit, so the lefthook pre-commit runs `--stage`:
the commit that ticks the last box carries the move, the log entry and the
index line. Agent hooks only run `--check`: they fire after the commit, where a
move would stay uncommitted.

Legacy (pre-OKF) plans are given frontmatter on the way, so a half-migrated
repo still archives correctly. Exits 0 always.

Usage:
    python scripts/archive_plans.py          # archive finished plans
    python scripts/archive_plans.py --stage  # pre-commit: archive, then stage docs/exec-plans and the indexes
    python scripts/archive_plans.py --check  # name finished plans waiting for a commit, move nothing
"""

from __future__ import annotations

import os
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "scripts"))
import _okf  # noqa: E402
import _plans  # noqa: E402
import check_okf  # noqa: E402


def completed_text(path: Path) -> str:
    text = path.read_text(errors="ignore")
    try:
        meta, body = _okf.split(text)
    except ValueError:
        meta, body = None, text
    if meta is None:
        meta, body = _okf.from_legacy(text, f"exec-plans/completed/{path.name}")
        meta["generated"] = {"by": "process:poise-archive", "at": _okf.now_iso()}
    meta.setdefault("type", "Exec Plan")
    meta["status"] = "stable"
    meta["completed_at"] = _okf.now_iso()
    return _okf.join(meta, body)


def append_log(plans_dir: Path, title: str, name: str) -> None:
    log = plans_dir / "log.md"
    today = datetime.now(timezone.utc).strftime("%Y-%m-%d")
    entry = f"- **Completion**: [{title}](completed/{name})\n"
    try:
        lines = log.read_text().splitlines(keepends=True) if log.exists() \
            else ["# Exec plan log\n", "\n"]
    except OSError:
        return
    heading = f"## {today}\n"
    first = next((i for i, l in enumerate(lines) if l.startswith("## ")), None)
    if first is not None and lines[first] == heading:
        lines.insert(first + 1, entry)
    else:
        at = first if first is not None else len(lines)
        lines[at:at] = [heading, entry, "\n"]
    try:
        log.write_text("".join(lines))
    except OSError:
        pass


def finished_plans() -> list[Path]:
    """Active plans with every box ticked. Empty and prose-only plans never count."""
    finished = []
    for path in _plans.iter_active_plans():
        info = _plans.parse_plan(path)
        if not path.is_symlink() and info["checked"] and not info["unchecked"]:
            finished.append(path)
    return finished


def archive(plans_dir: Path) -> None:
    completed = plans_dir / "completed"
    archived = False
    for path in finished_plans():
        info = _plans.parse_plan(path)
        target = completed / path.name
        try:
            completed.mkdir(parents=True, exist_ok=True)
            # Exclusive create: two processes cannot clobber history. The
            # source is removed only after the archived copy is written.
            with open(target, "x") as handle:
                handle.write(completed_text(path))
            path.unlink()
            append_log(plans_dir, info["title"], path.name)
            archived = True
            print(f"POISE: archived completed plan to docs/exec-plans/completed/{path.name}")
        except FileExistsError:
            print(
                f"POISE: {target.name} already exists in completed/. "
                "REMEDIATION: choose a unique plan filename and archive manually; both plans were preserved."
            )
        except OSError as error:
            print(
                f"POISE: could not archive {path.name}: {error}. "
                "REMEDIATION: move the completed plan manually without overwriting history."
            )
    if archived:
        try:
            check_okf.write_indexes(only_existing=True)
        except Exception:  # never fail the hook over an index refresh
            pass


def stage(plans_dir: Path) -> None:
    """Stage all plans with the listings, so a commit never links to a plan it lacks."""
    archive(plans_dir)
    check_okf.stage_indexes()
    subprocess.run(["git", "add", "--", str(plans_dir)], cwd=ROOT, check=False)


def check() -> None:
    for path in finished_plans():
        print(
            f"POISE: docs/exec-plans/active/{path.name} has every box ticked and has not moved to completed/. "
            "REMEDIATION: commit it now, on a branch if you are on the default branch. "
            "The pre-commit hook moves it to completed/ in that commit."
        )


def main() -> int:
    os.environ["CLAUDE_PROJECT_DIR"] = str(ROOT)
    plans_dir = ROOT / "docs/exec-plans"
    try:
        if "--check" in sys.argv:
            check()
        elif "--stage" in sys.argv:
            stage(plans_dir)
        else:
            archive(plans_dir)
    except Exception as error:  # a broken plan file must not stop a commit or a hook
        print(f"POISE: plan archiving skipped: {error}. REMEDIATION: fix the plan file, then commit again.")
    return 0


if __name__ == "__main__":
    sys.exit(main())

.PHONY: run test lint format check-arch check-style check gc plan deploy help

run:
	{{RUN_CMD}}

test:
	{{TEST_CMD}}

lint:
	{{LINT_CMD}}
	{{TYPECHECK_CMD}}

format:
	{{FORMAT_CMD}}

# Boundary linter — every violation includes a remediation instruction
check-arch:
	@echo "Checking architecture boundaries..."
	{{CHECK_ARCH_CMD}}
	@echo "Running structural tests..."
	{{STRUCTURAL_TEST_CMD}}

# Style / golden-principles linter (size, logging, naming, components)
check-style:
	@echo "Checking style invariants..."
	{{CHECK_STYLE_CMD}}
	@echo "Running structural style tests..."
	{{STRUCTURAL_STYLE_TEST_CMD}}

# Full mechanical check — arch + style. CI should target this.
check: check-arch check-style

# Garbage collection — deterministic sweep, then agent judgment pass
# Static sweep is read-only and exits 0 always; the agent command does
# the parts that require taste.
gc:
	@echo "Running deterministic gc sweep..."
	{{GC_STATIC_CMD}} | tee docs/gc-report-$$(date +%Y%m%d).md
	@echo "Static report saved."
	@echo "For the judgment-required passes, run /sync-docs in your agent."

# Create a new execution plan
plan:
ifndef name
	$(error Usage: make plan name=<slug>)
endif
	@cp docs/exec-plans/template.md docs/exec-plans/active/$(name).md
	@echo "Plan created: docs/exec-plans/active/$(name).md"

deploy:
	{{DEPLOY_CMD}}

help:
	@echo "{{REPO_NAME}}"
	@echo ""
	@echo "Dev:      make run"
	@echo "Test:     make test"
	@echo "Quality:  make lint | make format | make check (arch + style)"
	@echo "Harness:  make gc | make plan name=<slug>"
	@echo "Deploy:   make deploy"

# Language defaults:
#
# Python:
#   RUN_CMD:             uvicorn app.main:app --reload
